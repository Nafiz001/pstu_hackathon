# Copy to .env for local development (host process talking to the compose stack).
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Compose maps Postgres to 5433 so it never collides with a local install.
# Hosts are written as 127.0.0.1, never `localhost`. On Windows `localhost` resolves to ::1
# first, and Docker Desktop's IPv6 loopback forwarder stalls concurrent Postgres startup
# handshakes: the TCP connect succeeds, the handshake never completes, and pg gives up at
# connectionTimeoutMillis. Measured: 20 simultaneous connections, 0 failures over 127.0.0.1
# and up to 16 over ::1. See docs/chaos-results.md.
DATABASE_URL=postgres://takaflow:takaflow@127.0.0.1:5433/takaflow
TEST_DATABASE_URL=postgres://takaflow:takaflow@127.0.0.1:5433/takaflow_test

REDIS_URL=redis://127.0.0.1:6380

# Operator endpoints (freeze an account, search the audit log, run the workers on demand).
# Unset means those endpoints refuse every request — they fail closed, never open.
ADMIN_API_TOKEN=local-operator-token-change-me
# Operator console sign-in (exchanged for the token above).
ADMIN_USERNAME=judge
ADMIN_PASSWORD=takaflow-demo-2026

# Change in any non-local environment.
JWT_SECRET=dev-secret-change-me
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800

# Every account is funded with this on registration (BDT 100,000 in poisha).
SIGNUP_BONUS_MINOR=10000000

# Money policy (poisha).
MIN_TRANSFER_MINOR=100
MAX_TRANSFER_MINOR=5000000
DAILY_TRANSFER_LIMIT_MINOR=20000000

# Connection pool + statement guards.
PG_POOL_MAX=20
STATEMENT_TIMEOUT_MS=5000
LOCK_TIMEOUT_MS=3000

RUN_MIGRATIONS_ON_BOOT=true
